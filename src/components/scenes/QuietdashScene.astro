---
// quietdash: a calm e-ink ambient dashboard. Recreated as a warm device frame
// around a halftone screen rendering a few numbers like print, not glass.
const cells = [
  { label: 'Focus today', value: '4h 12m', sub: '+38m vs avg' },
  { label: 'Deep blocks', value: '3', sub: 'longest 96m' },
  { label: 'Inbox', value: '7', sub: 'down from 21' },
  { label: 'Steps', value: '6.4k', sub: '64% of goal' },
];
---
<div class="scene scene--quietdash" aria-hidden="true">
  <div class="qd-frame">
    <div class="qd-screen">
      <div class="qd-halftone"></div>
      <div class="qd-head">
        <span class="qd-title">Thursday</span>
        <span class="qd-meta">e-ink · refreshed 6m ago</span>
      </div>
      <div class="qd-grid">
        {cells.map((c) => (
          <div class="qd-cell">
            <span class="qd-label">{c.label}</span>
            <span class="qd-value">{c.value}</span>
            <span class="qd-sub">{c.sub}</span>
          </div>
        ))}
      </div>
    </div>
    <span class="qd-nub"></span>
  </div>
</div>
