---
// mambo: a native keyboard-driven database client. Recreated as a command
// palette over a small result grid. Decorative; the real app lives at the link.
const rows = [
  ['1024', 'ana@kessler.io', 'active', '2,481'],
  ['1025', 'mads@northbound.dev', 'active', '912'],
  ['1026', 'lou@petrichor.cc', 'trial', '47'],
  ['1027', 'kim@halden.studio', 'active', '6,330'],
];
---
<div class="scene scene--mambo" aria-hidden="true">
  <div class="mambo-win">
    <div class="mambo-bar">
      <span class="mambo-dots"><i></i><i></i><i></i></span>
      <span class="mambo-conn">postgres://prod · public</span>
      <span class="mambo-latency">12&nbsp;ms</span>
    </div>
    <div class="mambo-palette">
      <span class="mambo-kbd">⌘K</span>
      <span class="mambo-caret">select * from users where plan = 'active'</span>
    </div>
    <table class="mambo-grid">
      <thead>
        <tr><th>id</th><th>email</th><th>plan</th><th>mrr</th></tr>
      </thead>
      <tbody>
        {rows.map((r, i) => (
          <tr class={i === 1 ? 'is-sel' : ''}>
            <td class="num">{r[0]}</td>
            <td>{r[1]}</td>
            <td><span class={`pill pill--${r[2]}`}>{r[2]}</span></td>
            <td class="num">{r[3]}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="mambo-foot">
      <span>4 rows</span><span>0.8 ms</span><span class="mambo-hint">⏎ run · ⌥↑ history</span>
    </div>
  </div>
</div>
