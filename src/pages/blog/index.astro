---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';
import '../../styles/home.css';

const posts = await getPosts();
---

<Base title="Writing · fberrez" description="Notes and articles by Florent Berrez." ogSlug="index">
  <div class="home">
    <header class="intro">
      <h1 class="section-title">writing</h1>
      <p class="muted"><a href="/">← index</a></p>
    </header>

    {posts.length === 0 ? (
      <p class="muted">nothing here yet.</p>
    ) : (
      <ul class="text-list software-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <span class="project-meta">
              {' '}(<time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>{post.data.draft && ', draft'})
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
