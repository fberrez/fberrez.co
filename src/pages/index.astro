---
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../components/projects.js';

const wordmark = String.raw`   __ _
  / _| |__   ___ _ __ _ __ ___ ____
 | |_| '_ \ / _ \ '__| '__/ _ \_  /
 |  _| |_) |  __/ |  | | |  __// /
 |_| |_.__/ \___|_|  |_|  \___/___|`;
---

<Base>
  <div class="home">
    <header class="intro" aria-labelledby="site-title">
      <pre class="ascii-mark" aria-hidden="true">{wordmark}</pre>
      <h1 class="vh" id="site-title">Florent Berrez</h1>
      <p>software engineer in paris. i make small software and finish it.</p>
      <p class="muted">native apps and web tools, built to stay useful and small.</p>
    </header>

    <section aria-labelledby="software-title">
      <h2 class="section-title" id="software-title">software</h2>
      <div class="project-list">
        {PROJECTS.map((project, index) => {
          const Row = project.href ? 'a' : 'div';
          const linkProps = project.href
            ? {
                href: project.href,
                target: '_blank',
                rel: 'noopener noreferrer me',
              }
            : {};

          return (
            <Row
              class:list={[
                'project-row',
                { 'project-row--archived': project.state === 'archived' },
              ]}
              {...linkProps}
            >
              <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="project-name">{project.name}</span>
              <span class="project-description">{project.desc}</span>
              <span class={`project-status project-status--${project.state}`}>
                {project.stateLabel.toLowerCase()}
              </span>
              <span class="project-version">{project.version.toLowerCase()}</span>
              <span class="project-arrow" aria-hidden="true">
                {project.href ? '↗' : '·'}
              </span>
              <span class="vh">
                {project.href ? `opens ${project.domain} in a new tab` : 'archived project'}
              </span>
            </Row>
          );
        })}
      </div>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere-title">
      <h2 class="section-title" id="elsewhere-title">elsewhere</h2>
      <nav class="links" aria-label="Elsewhere">
        <!--email_off--><a href="mailto:hi@fberrez.co">email</a><!--email_on-->
        <a href="https://github.com/fberrez" rel="me noopener noreferrer" target="_blank">
          github
        </a>
        <a
          href="https://bsky.app/profile/fberrez.co"
          rel="me noopener noreferrer"
          target="_blank"
        >
          bluesky
        </a>
      </nav>
    </section>

    <footer class="site-footer">
      <span>paris, france</span>
      <span>© {new Date().getFullYear()} florent berrez</span>
    </footer>
  </div>
</Base>
