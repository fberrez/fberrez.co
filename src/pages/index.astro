---
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../components/projects.js';

const wordmark = String.raw`   __ _
  / _| |__   ___ _ __ _ __ ___ ____
 | |_| '_ \ / _ \ '__| '__/ _ \_  /
 |  _| |_) |  __/ |  | | |  __// /
 |_| |_.__/ \___|_|  |_|  \___/___|`;
---

<Base>
  <div class="home">
    <header class="intro" aria-labelledby="site-title">
      <pre class="ascii-mark" aria-hidden="true">{wordmark}</pre>
      <h1 class="vh" id="site-title">Florent Berrez</h1>
      <p>software engineer in paris. i make small software and finish it.</p>
      <p class="muted">native apps and web tools, built to stay useful and small.</p>
    </header>

    <section aria-labelledby="software-title">
      <h2 class="section-title" id="software-title">software</h2>
      <ul class="text-list software-list">
        {PROJECTS.map((project) => (
          <li class:list={[`project-item--${project.state}`]}>
            {project.href ? (
              <a href={project.href} target="_blank" rel="noopener noreferrer me">
                {project.name}:
                <span class="vh"> opens {project.domain} in a new tab</span>
              </a>
            ) : (
              <span class="archived-name">{project.name}:</span>
            )}
            <span class="project-copy"> {project.desc.toLowerCase()}</span>
            <span class="project-meta">
              {' '}({project.stateLabel.toLowerCase()}{project.version !== '—' ? `, ${project.version.toLowerCase()}` : ''})
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere-title">
      <h2 class="section-title" id="elsewhere-title">elsewhere</h2>
      <nav aria-label="Elsewhere">
        <ul class="text-list link-list">
          <li><!--email_off--><a href="mailto:hi@fberrez.co">email</a><!--email_on--></li>
          <li>
            <a href="https://github.com/fberrez" rel="me noopener noreferrer" target="_blank">
              github
            </a>
          </li>
        </ul>
      </nav>
    </section>

    <footer class="site-footer">paris, france. © {new Date().getFullYear()} florent berrez.</footer>
  </div>
</Base>
