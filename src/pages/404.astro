---
import Base from '../layouts/Base.astro';

// nginx.conf has pointed error_page 404 at /404.html since the first deploy;
// until now the file was never shipped, so a bad URL fell through to nginx's
// own default page.
---

<Base
  title="Not found — Florent Berrez"
  description="That page does not exist."
  noindex
  ogSlug="index"
>
  <section class="block">
    <span class="block-label">404</span>
    <div>
      <p class="say">That page does not exist.</p>
      <p class="sub">It may have moved, or it may never have been here.</p>
      <ul class="text-list link-list" style="margin-top:26px">
        <li><a href="/">Index</a></li>
        <li><!--email_off--><a href="mailto:hi@fberrez.co">hi@fberrez.co</a><!--email_on--></li>
      </ul>
    </div>
  </section>
</Base>
