---
import '../styles/global.css';
import ThemeControl from '../components/ThemeControl.astro';
import { getPosts } from '../lib/posts';

const SITE_URL = 'https://www.fberrez.co';
const UMAMI_WEBSITE_ID = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
// Search Console's "HTML tag" verification. Set the token on Railway and
// redeploy, then press Verify in Search Console. Same pattern as the analytics
// id above: unset means the tag is simply omitted.
const GOOGLE_SITE_VERIFICATION = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

interface Props {
  title?: string;
  description?: string;
  /** Set on article pages so search engines and social cards read them as posts. */
  article?: { published: Date; modified?: Date };
  /** Which nav item is current. */
  section?: 'index' | 'writing';
  /** Keep a page out of the index — used for the archive while it is empty. */
  noindex?: boolean;
  /** Borrow another page's social card. Pages without one of their own set this. */
  ogSlug?: string;
}

const DEFAULT_TITLE = 'Florent Berrez — makes small software and finishes it';
const DEFAULT_DESCRIPTION =
  'Florent Berrez is a software engineer in Paris. He builds small, native apps and web tools — foyer, minihabits, mambo, quietdash, blurt.sh — and writes about shipping them.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  article,
  section = 'index',
  noindex = false,
  ogSlug: ogSlugOverride,
} = Astro.props;

// Until there is something to read, the site does not advertise a blog: no
// Writing tab, no RSS tab, and no Writing block on the home page. Both routes
// keep building, so dropping one markdown file brings all of it back at once.
const hasPosts = (await getPosts()).length > 0;

const canonical = new URL(Astro.url.pathname, SITE_URL).toString();

// Each page has its own card, generated by src/pages/og/[...slug].png.ts. The
// slug mirrors the pathname, so nothing has to be wired up per page.
const ogSlug = ogSlugOverride ?? (Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index');
const ogImage = new URL(`/og/${ogSlug}.png`, SITE_URL).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Florent Berrez',
  alternateName: ['Flo Berrez', 'fberrez'],
  url: SITE_URL,
  jobTitle: 'Software Engineer',
  description: DEFAULT_DESCRIPTION,
  address: { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
  email: 'mailto:hi@fberrez.co',
  sameAs: ['https://github.com/fberrez', 'https://github.com/mambo-corp'],
  knowsAbout: [
    'Software engineering',
    'Database tooling',
    'Developer ergonomics',
    'Keyboard-driven interfaces',
    'TypeScript',
    'Tauri',
    'Astro',
  ],
  worksFor: { '@type': 'Organization', name: 'mambo-corp', url: 'https://github.com/mambo-corp' },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'fberrez.co',
  url: SITE_URL,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Florent Berrez', url: SITE_URL },
};

const articleJsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.published.toISOString(),
  ...(article.modified ? { dateModified: article.modified.toISOString() } : {}),
  url: canonical,
  mainEntityOfPage: canonical,
  author: { '@type': 'Person', name: 'Florent Berrez', url: SITE_URL },
  publisher: { '@type': 'Person', name: 'Florent Berrez', url: SITE_URL },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#22262c" media="(prefers-color-scheme: dark)" />

    {/*
      Runs before first paint so an explicit preference never flashes the wrong
      theme. It only writes data-theme when the choice is explicit — on "system"
      the attribute is absent and the prefers-color-scheme rules take over, which
      is also exactly what happens when JavaScript never runs.
    */}
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem('theme');
          if (pref === 'light' || pref === 'dark') {
            document.documentElement.setAttribute('data-theme', pref);
          }
        } catch (e) {
          /* private mode or storage disabled: fall through to system preference */
        }
      })();
    </script>

    {GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Florent Berrez" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Florent Berrez — writing"
      href={new URL('/rss.xml', SITE_URL).toString()}
    />

    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'
      }
    />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="fberrez.co" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && (
      <meta property="article:published_time" content={article.published.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@fberrez" />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}

    {/*
      Analytics is the only third-party origin on the page, and Lighthouse
      measured 168 ms lost to setting up its connection. Fonts and CSS are
      same-origin, so this is the one preconnect worth spending.
    */}
    {UMAMI_WEBSITE_ID && (
      <>
        <link rel="preconnect" href="https://umami.fberrez.co" crossorigin />
        <link rel="dns-prefetch" href="https://umami.fberrez.co" />
        <script defer src="https://umami.fberrez.co/script.js" data-website-id={UMAMI_WEBSITE_ID} />
      </>
    )}
  </head>
  <body>
    <div class="rig" aria-hidden="true"><i class="l1"></i><i class="l2"></i></div>

    <div class="page">
      <header class="mast">
        <a class="mast-name" href="/">Florent Berrez</a>
        <nav aria-label="Sections">
          <a href="/" aria-current={section === 'index' ? 'page' : undefined}>Index</a>
          {(hasPosts || section === 'writing') && (
            <a href="/writing" aria-current={section === 'writing' ? 'page' : undefined}>
              Writing
            </a>
          )}
          {hasPosts && <a href="/rss.xml">RSS</a>}
        </nav>
        <ThemeControl />
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
